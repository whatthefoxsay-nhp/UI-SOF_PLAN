{
  "name": "sof-plan",
  "version": "1.0.0",
  "description": "Ung dung Quan ly Ke hoach va Cong viec - SOF PLAN",
  "main": "public/electron.js",
  "private": true,
  "homepage": "./",
  "author": "PMBH Team",
  "proxy": "http://localhost",
  "scripts": {
    "electron": "electron .",
    "electron-dev": "set ELECTRON_IS_DEV=true && electron .",
    "electron-dev-mac": "env -u ELECTRON_RUN_AS_NODE ELECTRON_IS_DEV=true electron .",
    "electron-only": "npm run build && electron .",
    "electron-test": "set ELECTRON_IS_DEV=false && npm run build && electron .",
    "electron-mac": "npm run build && env -u ELECTRON_RUN_AS_NODE ELECTRON_IS_DEV=false electron .",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-pack": "electron-builder",
    "preelectron-pack": "npm run build",
    "dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npm run electron-dev\"",
    "dev-mac": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npm run electron-dev-mac\"",
    "dev-web": "npm start",
    "dist": "npm run build && electron-builder --publish=never",
    "build-win": "npm run build && electron-builder --win",
    "build-mac": "npm run build && electron-builder --mac",
    "build-linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "http://localhost:3000",
    "productName": "SOF PLAN",
    "electronVersion": "27.1.3",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "public/ipcHandlers.js",
      "public/dataWorker.js",
      "public/images/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "public/logo.icns"
    },
    "win": {
      "icon": "public/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": "zip",
      "category": "Office",
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SOF PLAN"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "electron-is-dev": "^2.0.0",
    "electron-store": "^8.1.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "morgan": "^1.10.1",
    "react-i18next": "^17.0.10",
    "react-quill": "^2.0.0",
    "react-to-print": "^3.3.0",
    "uuid": "^11.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.2.6",
    "@tanstack/react-query": "^5.90.2",
    "antd": "^5.12.8",
    "axios": "^1.7.9",
    "concurrently": "^8.2.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.18",
    "electron": "^27.1.3",
    "electron-builder": "^24.6.4",
    "electron-packager": "^17.1.2",
    "http-proxy-middleware": "^3.0.5",
    "lodash": "^4.17.21",
    "lucide-react": "^0.542.0",
    "moment": "^2.29.4",
    "qrcode.react": "^4.2.0",
    "qs": "^6.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "react-scripts": "^5.0.1",
    "react-window": "^2.1.2",
    "react-window-infinite-loader": "^2.0.0",
    "recharts": "^2.15.4",
    "styled-components": "^6.1.6",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "postcss": "^8.5.15",
    "serialize-javascript": "^6.0.2",
    "tar": "^7.5.15",
    "ws": "^8.21.0",
    "underscore": "^1.13.8",
    "uuid": "^11.1.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
